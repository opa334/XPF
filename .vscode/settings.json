{
	"C_Cpp.default.compilerPath": "/usr/bin/clang",
	"clangd.fallbackFlags": [
		"-I${workspaceFolder}/external/ChOma/include",
		"-I${workspaceFolder}/external/img4lib",
		"-I/opt/homebrew/opt/openssl@3/include",
		"-DUSE_COMMONCRYPTO",
		"-DUSE_LIBCOMPRESSION",
		"-DiOS10",
		"-D__unused=\"__attribute__((unused))\"",
		"-DDER_MULTIBYTE_TAGS=1",
		"-DDER_TAG_SIZE=8",
	],
	"files.associations": {
		"*.ejs": "html",
		"codedirectory.h": "c",
		"templatesignatureblob.h": "c",
		"loader.h": "c",
		"__hash_table": "c",
		"__split_buffer": "c",
		"array": "c",
		"bitset": "c",
		"initializer_list": "c",
		"span": "c",
		"string": "c",
		"string_view": "c",
		"unordered_map": "c",
		"vector": "c"
	}
}